    <PackageReference Include="Snappier" Version="1.3.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Tooyioo.Api\Tooyioo.Api.csproj" />
  </ItemGroup>

</Project>
