<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
        <LangVersion>latest</LangVersion>
        <!--XML Comments for OpenAPI-->
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <!--
            Slicent uses its own [DomainEventType] marker and a per-container TypeMapper.
            Eventuous's EVTC001 only understands [EventType] or a local TypeMapper.AddType call,
            so it reports a false positive for events declared in the Contracts assemblies.
        -->
        <NoWarn>$(NoWarn);1591;EVTC001</NoWarn>
        <!--End of XML Comments for OpenAPI-->
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\Slicent\Slicent.csproj" />
        <ProjectReference Include="..\..\Tooyioo.Common\Tooyioo.Common.csproj" />
        <ProjectReference Include="..\Tooyioo.User.Contracts\Tooyioo.User.Contracts.csproj" />
    </ItemGroup>

</Project>
