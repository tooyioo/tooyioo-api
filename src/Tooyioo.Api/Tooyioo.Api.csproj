<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
        <!--OpenApi-->
        <OpenApiDocumentsDirectory>.</OpenApiDocumentsDirectory>
        <LangVersion>latest</LangVersion>
        <UserSecretsId>8cc4ed73-e88d-40e1-8a36-17f74554ab89</UserSecretsId>
  </PropertyGroup>
    
    <ItemGroup>
        <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.13" />
        <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.13" />
        <PackageReference Include="Microsoft.Extensions.ApiDescription.Server" Version="10.0.13">
          <PrivateAssets>all</PrivateAssets>
          <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
        <PackageReference Include="Microsoft.Extensions.Http.Resilience" Version="10.11.0" />
        <PackageReference Include="Microsoft.Extensions.ServiceDiscovery" Version="10.11.0" />
        <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.20.1" />
        <PackageReference Include="OpenTelemetry.Extensions.Hosting" Version="1.20.1" />
        <PackageReference Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.20.1" />
        <PackageReference Include="OpenTelemetry.Instrumentation.Http" Version="1.20.1" />
        <PackageReference Include="OpenTelemetry.Instrumentation.Runtime" Version="1.20.1" />
        <PackageReference Include="Scalar.AspNetCore" Version="2.18.2" />
        <PackageReference Include="libphonenumber-csharp" Version="9.0.41" />
    </ItemGroup>
    
    <ItemGroup>
      <ProjectReference Include="..\Slicent\Slicent.csproj" />
      <ProjectReference Include="..\user-onboarding\Tooyioo.UserOnboarding\Tooyioo.UserOnboarding.csproj" />
      <ProjectReference Include="..\user\Tooyioo.User\Tooyioo.User.csproj" />
    </ItemGroup>

</Project>
