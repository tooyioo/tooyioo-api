meta {
  name: cancel-user-onboarding
  type: http
  seq: 3
}

put {
  url: {{baseUrl}}/users/{{dynamicUserId}}/onboarding/cancellation
  body: json
  auth: inherit
}

body:json {
  {
    "reasonCode": "Terms and Conditions rejected"
  }
}

script:post-response {
  bru.setVar("dynamicUserId", null);
}

settings {
  encodeUrl: true
  timeout: 0
}
