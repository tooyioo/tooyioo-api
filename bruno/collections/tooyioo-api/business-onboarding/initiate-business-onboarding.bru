meta {
  name: initiate-business-onboarding
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/businesses
  body: json
  auth: inherit
}

body:json {
  {
    "legalName": "Acme Ltd"
  }
}

script:post-response {
  bru.setVar("dynamicBusinessId", res.body.businessId);
}

settings {
  encodeUrl: true
  timeout: 0
}
